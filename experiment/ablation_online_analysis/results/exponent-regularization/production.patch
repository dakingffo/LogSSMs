+    def _exposure(self, begin: int, end: int) -> float:
+        if end <= begin:
+            return 0.0
+        rate = math.log(2) / self.hit_half_life
+        return self._weight(end) * (-math.expm1(-rate * (end - begin))) / (-math.expm1(-rate))
