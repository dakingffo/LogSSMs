+            lo, hi = 0.0, self.max_density_exponent
+            for _ in range(40):
+                mid = (lo + hi) / 2
+                mass, moment = terms(mid)
+                derivative = (total + alpha) * moment / (mass + beta) - observed - (mid - 2.0)
